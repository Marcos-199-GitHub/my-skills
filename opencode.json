{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "main-agent": {
      "permissions": [
        {
          "action": "shell",
          "resource": "git push gitea *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push http://*13000/gitea/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push *--force*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push *--delete*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git push gitea +*",
          "effect": "ask"
        }
      ]
    }
  }
}
